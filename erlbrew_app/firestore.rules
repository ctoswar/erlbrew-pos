rules_version = '2';
service cloud.firestore {
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return isSignedIn() && request.auth.uid == userId;
  }

  function isAdmin(database) {
    return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
      && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
  }

  match /databases/{database}/documents {
    match /users/{userId} {
      allow create: if isOwner(userId)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'customer'
        && request.resource.data.isAdmin == false;

      allow read: if isOwner(userId) || isAdmin(database);

      allow update: if (isOwner(userId)
          && request.resource.data.role == resource.data.role
          && request.resource.data.isAdmin == resource.data.isAdmin
          && request.resource.data.isAdmin == false)
        || (isAdmin(database)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['points', 'updatedAt']));

      allow delete: if isAdmin(database);
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read: if isOwner(userId) || isAdmin(database);
      allow create: if isAdmin(database);
      allow update, delete: if isOwner(userId) || isAdmin(database);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
