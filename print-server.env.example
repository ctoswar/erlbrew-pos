# ── Erlbrew POS Print Server (Pi, Rust) ─────────────────────────────────────
# Copy to print-server/.env and edit values. Keep .env on the Pi only — never commit it.

# Bluetooth MAC of your thermal printer (or 'none' to disable)
BT_PRINTER_MAC=BT_PRINTER_MAC

# Printer type: 'bluetooth' (direct RFCOMM), 'cups' (via lpr), or 'none' (log only)
PRINTER_TYPE=bluetooth

# Port to listen on (default: 9100)
PRINT_SERVER_PORT=9100

# RFCOMM channel (default: 1)
# BT_CHANNEL=1

# For CUPS printing only:
# CUPS_PRINTER=thermal

# Latency knobs (defaults are fine for a Pi 3B+):
# BT_CONNECT_TIMEOUT_MS=8000
# BT_WRITE_TIMEOUT_MS=5000
# DRAWER_INIT_DELAY_MS=50
# BT_IDLE_TIMEOUT_SECS=0

# TLS: cert.pem/key.pem are self-signed automatically (regenerated weekly).
# TLS_DISABLE=1
# TLS_SANS=192.168.75.101,localhost

# CORS allowlist for the POS frontend (default: allow all)
# ALLOWED_ORIGINS=*
