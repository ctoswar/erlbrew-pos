# Erlbrew customer app — backend URL configuration
#
# Copy to config/.env (git-ignored) and set POS_API_URL to the machine running
# the backend (infra/docker-compose.yml: erlbw-api directly, or erlbrew-pos nginx):
#
#   flutter run  --dart-define-from-file=config/.env   (dev)
#   flutter build apk --release --dart-define-from-file=config/.env
#
# Consumer: lib/services/pos_api_service.dart (PosApiService.baseUrl).
#
# Examples:
#   POS_API_URL=http://localhost:3001        backend on this PC, dev on emulator/web
#   POS_API_URL=http://10.0.2.2:3001         Android emulator reaching host on 3001
#   POS_API_URL=https://192.168.75.100:3004  phone -> PC running the compose stack (nginx TLS)
#   POS_API_URL=https://pos.example.com/app  phone -> public URL (tunnel/hosted)
POS_API_URL=http://localhost:3001
