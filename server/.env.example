# ── Erlbrew POS Backend Configuration ──
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# Server
PORT=3001

# Database (MySQL)
DATABASE_URL=mysql://user:password@host:3306/erlbrew_pos

# JWT — Must be a strong random string in production
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# CORS — Comma-separated list of allowed origins
# Example: http://localhost:3000,http://192.168.1.100:3004
# Include every browser origin used to access the POS. Keep the scheme and
# port exact; add custom LAN/Tailscale hostnames explicitly.
CORS_ORIGINS=http://localhost:3000,http://pos.lan

# Google Sheets Integration (optional — leave empty to disable)
GOOGLE_SHEETS_ID=
# Firebase login (staff + customer sign-in via /api/*/firebase-login).
# The service account JSON must come from the SAME Firebase project as the
# client apps (erlbrew_app/lib/firebase_options.dart) — otherwise every login
# fails with 401 "Invalid Firebase credentials" and the server log shows an
# "aud" (audience) claim mismatch.
# FIREBASE_SERVICE_ACCOUNT_KEY is read first; GOOGLE_SERVICE_ACCOUNT_KEY is the
# legacy fallback. Staff roles come from Firestore users/{uid}
# (role: "admin" | "manager", or isAdmin: true).
FIREBASE_SERVICE_ACCOUNT_KEY=
GOOGLE_SERVICE_ACCOUNT_KEY=

# Optional local Ollama briefing (deterministic analytics never depends on it)
# In Docker use http://ollama:11434; on the host use http://127.0.0.1:11434.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3.5:2b
OLLAMA_TIMEOUT_MS=5000